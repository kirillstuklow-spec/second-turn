[resource]
script = ExtResource("1_plan")
plan_id = "object.sulfur_cloud.fire_explosion"
topology = 0
nodes = Array[ExtResource("2_node")]([SubResource("Resource_explosion_damage"), SubResource("Resource_apply_burning")])
