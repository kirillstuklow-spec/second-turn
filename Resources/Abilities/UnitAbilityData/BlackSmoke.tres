[resource]
script = ExtResource("2_unit_ability")
ability_name = "Чёрный дым"
description = "Размещает завесу 3×3 на два полных последующих раунда. Все юниты внутри получают нерасходуемую защиту от дальних воздействий. FIRE внутри рассеивает дым даже при блокировке. Длительность тестовая."
ability = ExtResource("1_ability")
