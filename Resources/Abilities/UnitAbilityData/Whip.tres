[resource]
script = ExtResource("2_unit_ability")
ability_name = "Хлыст"
description = "Применяет к соседнему союзнику HEALING величиной -1. Если потеря HP применена и цель выжила, накладывает Подгон до конца следующего раунда: +10 инициативы, +1 к движению и одно предотвращение смерти с возвратом к 1 HP. Все числа тестовые."
ability = ExtResource("1_ability")
impact_plan_data = ExtResource("3_plan")
action_point_cost = 1
