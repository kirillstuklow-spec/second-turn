[gd_resource type="Resource" script_class="BattlefieldObjectData" format=3 uid="uid://dl04tsxy6okvf"]

[ext_resource type="Script" uid="uid://pvfg6jbrc040" path="res://Resources/BattlefieldObjects/BattlefieldObjectData.gd" id="1_object"]
[ext_resource type="Script" uid="uid://dn63kyighh55r" path="res://Resources/BattlefieldObjects/BattlefieldObjectTriggerData.gd" id="2_trigger"]
[ext_resource type="Resource" path="res://Resources/BattlefieldObjects/SulfurCloudVisual.tres" id="3_visual"]
[ext_resource type="Resource" uid="uid://b0oa1xk60mekp" path="res://Resources/Abilities/ImpactPlans/SulfurCloudPeriodicPlan.tres" id="4_periodic"]
[ext_resource type="Resource" uid="uid://dbk1w2llstddw" path="res://Resources/Abilities/ImpactPlans/SulfurCloudExplosionPlan.tres" id="5_explosion"]

[sub_resource type="Resource" id="Resource_activation_end_trigger"]
script = ExtResource("2_trigger")
trigger_id = "sulfur_activation_end_inside"
response_plan_data = ExtResource("4_periodic")

[sub_resource type="Resource" id="Resource_fire_trigger"]
script = ExtResource("2_trigger")
trigger_id = "sulfur_fire_hit_inside"
event_kind = 12
source_type_filter = "fire"
target_policy = 1
consume_object_on_trigger = true
response_plan_data = ExtResource("5_explosion")

[sub_resource type="Resource" id="Resource_neighbor_explosion_trigger"]
script = ExtResource("2_trigger")
trigger_id = "sulfur_neighbor_explosion"
event_kind = 13
source_type_filter = "fire"
minimum_applied_amount = 1
event_location_policy = 1
target_policy = 1
consume_object_on_trigger = true
response_plan_data = ExtResource("5_explosion")

[resource]
script = ExtResource("1_object")
object_id = "field_object.sulfur_cloud"
object_name = "Облако серы"
description = "Временный объект 3×3. Наносит яд в конце активации каждого юнита внутри. Применённый FIRE по покрытой клетке или юниту взрывает объект, наносит огненный урон всем внутри и накладывает Горение. Взрыв передаётся перекрывающемуся или соседнему стороной облаку серы."
coverage_offsets = Array[Vector2i]([Vector2i(-1, -1), Vector2i(0, -1), Vector2i(1, -1), Vector2i(-1, 0), Vector2i(0, 0), Vector2i(1, 0), Vector2i(-1, 1), Vector2i(0, 1), Vector2i(1, 1)])
lifetime_rounds = 2
triggers = Array[ExtResource("2_trigger")]([SubResource("Resource_activation_end_trigger"), SubResource("Resource_fire_trigger"), SubResource("Resource_neighbor_explosion_trigger")])
visual_data = ExtResource("3_visual")
