[gd_resource type="Resource" script_class="UnitData" format=3]

[ext_resource type="Script" path="res://Resources/Unit/UnitData.gd" id="1_unit"]
[ext_resource type="Script" path="res://Resources/Abilities/UnitAbilityData/UnitAbilityData.gd" id="2_unit_ability"]
[ext_resource type="Resource" path="res://Resources/Abilities/UnitAbilityData/GhoulLeap.tres" id="3_leap"]
[ext_resource type="Resource" path="res://Resources/Abilities/UnitAbilityData/GhoulBite.tres" id="4_bite"]
[ext_resource type="Resource" path="res://Resources/Abilities/UnitAbilityData/GhoulBiteKillHeal.tres" id="5_kill_heal"]

[resource]
script = ExtResource("1_unit")
unit_id = "ghoul_test"
unit_name = "Гуль"
description = "Тестовый профиль Гуля с Укусом, Разложением, лечением после подтверждённого убийства и Прыжком. Числовые характеристики не являются балансными."
faction = "undead"
unit_class = "skirmisher"
initiative = 35
max_hp = 10
armor = 0
movement = 2
keywords = Array[String](["undead", "ghoul"])
active_abilities = Array[ExtResource("2_unit_ability")]([ExtResource("4_bite"), ExtResource("3_leap")])
passive_abilities = Array[ExtResource("2_unit_ability")]([ExtResource("5_kill_heal")])
